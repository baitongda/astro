---
import { getEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  keywords?: string[];
  ogType?: 'website' | 'article' | 'product';
  robots?: string;
}

const home = await getEntry('home', 'landing');
if (!home) {
  throw new Error('Missing src/content/home/landing.md');
}

const {
  title,
  description,
  keywords,
  ogType,
  robots,
} = Astro.props;
const pageTitle = title ?? home.data.seo.title;
const pageDescription = description ?? home.data.seo.description;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  keywords={keywords}
  ogType={ogType}
  robots={robots}
  siteName={home.data.brand.name}
>
  <Header data={home.data} />
  <main id="main-content">
    <slot />
  </main>
  <Footer data={home.data} />
</BaseLayout>