---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { ArrowUpRight, Boxes } from '@lucide/astro';

const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
const siteOrigin = Astro.site ?? Astro.url.origin;
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: '产品与工具',
  itemListElement: products.map((entry, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: entry.data.title,
    url: new URL(`/products/${entry.id}/`, siteOrigin).href,
  })),
};
---

<SiteLayout
  title="产品与工具｜你的 AI 办公工作室"
  description="整理 AI 办公工具、Web 安全产品与独立应用的定位、能力、适用场景和官方资料。"
  keywords={['AI 办公工具', 'Web 安全产品', '独立应用', '产品选型']}
>
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />

  <section class="page-hero">
    <div class="container page-hero__inner">
      <div class="eyebrow"><Boxes size={15} stroke-width={2.2} />产品与工具</div>
      <h1>找到真正能解决问题的产品</h1>
      <p>围绕产品定位、核心能力、适用场景和官方资料进行整理，方便后续持续更新和选型比较。</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card-grid">
        {products.map((entry) => (
          <article class="content-card">
            <div class="content-card__meta">
              <span>{entry.data.productType || entry.data.category}</span>
              <span>{entry.data.status}</span>
            </div>
            <h2>{entry.data.title}</h2>
            <p>{entry.data.description}</p>
            <div class="content-card__footer">
              <a href={`/products/${entry.id}`}>查看详情</a>
              {entry.data.url && (
                <a href={entry.data.url} target="_blank" rel="noreferrer" aria-label={`打开 ${entry.data.title} 官方页面`}>
                  <ArrowUpRight size={18} stroke-width={2.3} />
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</SiteLayout>