---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { ArrowUpRight } from '@lucide/astro';

const notes = (await getCollection('notes')).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
);
const formatDate = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
---

<SiteLayout title="学习笔记｜你的 AI 办公工作室" description="记录 AI 办公、自动化流程和独立产品开发中的真实方法。">
  <section class="page-hero">
    <div class="container page-hero__inner">
      <div class="eyebrow">学习笔记</div>
      <h1>把做过的事写下来，变成下一次可以直接使用的方法</h1>
      <p>这里用于发布文章、课程补充、工具观察和项目复盘。新增内容会直接出现在列表中。</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {notes.length ? (
        <div class="notes-list">
          {notes.map((entry, index) => (
            <a class="note-row" href={`/notes/${entry.id}`} aria-label={`阅读 ${entry.data.title}`}>
              <div class="note-row__date">
                <span>{formatDate.format(entry.data.publishDate)}</span>
                <small>{String(index + 1).padStart(2, '0')}</small>
              </div>

              <div class="note-row__content">
                <div class="note-row__meta">
                  {entry.data.featured && <span class="note-row__featured">精选</span>}
                  <span>{entry.data.tags.join(' · ') || '学习笔记'}</span>
                </div>
                <h2>{entry.data.title}</h2>
                <p>{entry.data.description || '暂无摘要。'}</p>
              </div>

              <div class="note-row__aside">
                <span class="note-row__read">阅读笔记</span>
                <ArrowUpRight size={20} stroke-width={2.1} />
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="empty-state">还没有发布学习笔记。</p>
      )}
    </div>
  </section>
</SiteLayout>