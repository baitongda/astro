---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { ArrowRight, CalendarDays } from '@lucide/astro';

const notes = (await getCollection('notes')).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
);
const formatDate = new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
---

<SiteLayout title="学习笔记｜你的 AI 办公工作室" description="记录 AI 办公、自动化流程和独立产品开发中的真实方法。">
  <section class="page-hero">
    <div class="container page-hero__inner">
      <div class="eyebrow">学习笔记</div>
      <h1>把做过的事写下来，变成下一次可以直接使用的方法</h1>
      <p>这里用于发布文章、课程补充、工具观察和项目复盘。新增内容会直接出现在列表中。</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {notes.length ? (
        <div class="card-grid">
          {notes.map((entry) => (
            <article class="content-card">
              <div class="content-card__meta">
                <span><CalendarDays size={14} stroke-width={2.1} /> {formatDate.format(entry.data.publishDate)}</span>
                {entry.data.featured && <span>精选</span>}
              </div>
              <h2>{entry.data.title}</h2>
              <p>{entry.data.description}</p>
              <div class="content-card__footer">
                <span>{entry.data.tags.join(' · ')}</span>
                <a href={`/notes/${entry.id}`} aria-label={`阅读 ${entry.data.title}`}>
                  <ArrowRight size={18} stroke-width={2.3} />
                </a>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <p class="empty-state">还没有发布学习笔记。</p>
      )}
    </div>
  </section>
</SiteLayout>